{
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.3.1",
    "@mui/material": "9.3.1",
    "i18next": "26.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@ffflorian/prettier-config": "1.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "~26",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/ui": "4.1.11",
    "eslint": "9.39.5",
    "eslint-plugin-oxlint": "1.80.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "name": "justincase-frontend",
  "prettier": "@ffflorian/prettier-config",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && yarn prepare:commit && vite build",
    "clean": "rm -rf dist",
    "dev": "yarn start:dev",
    "format": "yarn prettier --write",
    "lint": "oxlint . && eslint . && yarn prettier --check",
    "prettier": "prettier --ignore-path ../../.prettierignore .",
    "preview": "vite preview",
    "prepare:commit": "echo \"VITE_COMMIT_ID=${SOURCE_COMMIT:-main}\" >> .env.production ",
    "start:dev": "vite",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "dist": "yarn clean && yarn build"
  },
  "type": "module",
  "version": "0.1.0"
}
