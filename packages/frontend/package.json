{
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.0.1",
    "@mui/material": "9.0.1",
    "i18next": "26.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "17.0.8",
    "react-router-dom": "7.15.1"
  },
  "devDependencies": {
    "@ffflorian/eslint-config-react": "0.2.2",
    "@ffflorian/prettier-config": "0.8.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "~24",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/ui": "4.1.8",
    "eslint": "9.39.4",
    "eslint-plugin-oxlint": "1.67.0",
    "jsdom": "29.1.1",
    "oxlint": "1.67.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "name": "justincase-frontend",
  "prettier": "@ffflorian/prettier-config",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && yarn prepare:commit && vite build",
    "clean": "rm -rf dist",
    "dev": "yarn start:dev",
    "format": "yarn prettier --write",
    "lint": "eslint . && yarn prettier --check",
    "prettier": "prettier --ignore-path ../../.prettierignore .",
    "preview": "vite preview",
    "prepare:commit": "echo \"VITE_COMMIT_ID=${SOURCE_COMMIT:-main}\" >> .env.production ",
    "start:dev": "vite",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "dist": "yarn clean && yarn build"
  },
  "type": "module",
  "version": "0.1.0"
}
